# Supabase (projet créé en région UE, ex. Frankfurt eu-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PostgreSQL Supabase : URL du pooler (transaction, port 6543) pour l'application
DATABASE_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# URL directe (port 5432) pour les migrations Prisma
DIRECT_URL="postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# URL publique de l'application (liens d'invitation)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clé service_role Supabase (serveur uniquement, jamais exposée au navigateur) :
# nécessaire pour supprimer un compte (droit à l'effacement).
SUPABASE_SERVICE_ROLE_KEY=eyJ...
